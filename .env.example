# Documentation only: the runner reads environment variables, not this file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required for answer unless --model is provided; use your provider's vision model ID.
OPENAI_MODEL=
BLENDER_BIN=/path/to/blender
# Optional in mainland China:
# HF_ENDPOINT=https://hf-mirror.com
# Optional authenticated asset downloads:
# HF_TOKEN=
